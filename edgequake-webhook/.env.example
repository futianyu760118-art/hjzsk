# ── EdgeQuake Webhook 配置 ──────────────────────────────────
# 复制为 .env 后填写。.env 含密钥，不要提交到仓库。

# Gitee 访问令牌（只读仓库权限即可；注册 Webhook 需要 hook 权限）
GITEE_TOKEN=
# Gitee 用户名（Gitee HTTPS 认证需要 用户名:token 形式，私有仓 clone 必填）
GITEE_USERNAME=
# Gitee Webhook 密码（留空则自动生成随机串并打印）
GITEE_WEBHOOK_TOKEN=

# EdgeQuake 服务地址
EDGEQUAKE_URL=http://127.0.0.1:8080
# EdgeQuake API Key（若 EdgeQuake 开启认证则必填）
EDGEQUAKE_API_KEY=
# EdgeQuake 工作区 ID（不填则用默认工作区）
EDGEQUAKE_WORKSPACE_ID=

# Webhook 接收服务
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9000
WEBHOOK_WORKERS=2

# 要接入的仓库，多个用分号分隔：full_name|url
# 不写 url 则默认 https://gitee.com/{full_name}.git
REPOSITORIES=ningbohengjianguangdian/hengjian-knowledge-hub|https://gitee.com/ningbohengjianguangdian/hengjian-knowledge-hub.git

# 只处理这些分支
ALLOWED_BRANCHES=main,master

# 单次推送最多处理的文件数
MAX_FILES_PER_PUSH=200
# 单文件最大摄入字节数（默认 1 MiB）
MAX_FILE_BYTES=1048576
# 摄入请求超时（秒）
INGEST_TIMEOUT=120
